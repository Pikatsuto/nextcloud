# =====================================================================
# Secrets template. Copy to .env and fill in:  cp .env.example .env
# The real .env is gitignored and is NEVER pushed to GitHub.
# =====================================================================

# --- Nextcloud admin ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me

# --- PostgreSQL ---
POSTGRES_PASSWORD=change-me

# --- Redis ---
REDIS_PASSWORD=change-me

# --- Collabora ---
COLLABORA_USERNAME=admin
COLLABORA_PASSWORD=change-me

# --- Domains / hosts / paths (infra) ---
NEXTCLOUD_DOMAIN=nextcloud.example.com
COLLABORA_DOMAIN=collabora.example.com
KOP_BIND_HOST=docker-host
DATA_ROOT=/srv/appdata/nextcloud

# Reverse proxies allowed by Nextcloud (space-separated CIDRs)
TRUSTED_PROXIES=127.0.0.1 172.16.0.0/12

# --- OnlyOffice (OOXML) ---
ONLYOFFICE_DOMAIN=onlyoffice.example.com
ONLYOFFICE_JWT_SECRET=change-me
